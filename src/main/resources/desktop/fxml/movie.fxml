<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="page"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.MovieController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="DANH SÁCH PHIM" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblCount" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
        <Button text="+ Thêm phim" onAction="#onAdd" styleClass="primary"/>
    </HBox>

    <!-- Filters -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="chart-container">
        <TextField fx:id="tfSearch" promptText="Tìm theo tên phim..." prefWidth="240"/>
        <ComboBox fx:id="cbGenre" prefWidth="180" promptText="Tất cả thể loại"/>
        <ComboBox fx:id="cbStatus" prefWidth="180" promptText="Tất cả trạng thái"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Sắp xếp theo:" style="-fx-text-fill: #4b5563; -fx-font-weight: bold;"/>
        <ComboBox fx:id="cbSort" prefWidth="160"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" text="Tên phim" prefWidth="280"/>
            <TableColumn fx:id="colGenre" text="Thể loại" prefWidth="140"/>
            <TableColumn fx:id="colDuration" text="Thời lượng" prefWidth="110"/>
            <TableColumn fx:id="colRelease" text="Khởi chiếu" prefWidth="110"/>
            <TableColumn fx:id="colAge" text="Độ tuổi" prefWidth="90"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="140"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Pagination -->
    <HBox alignment="CENTER">
        <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
    </HBox>
</VBox>
